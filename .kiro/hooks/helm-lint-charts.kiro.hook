{
  "enabled": true,
  "name": "Helm Lint Charts",
  "description": "Runs helm lint on the platform charts (appset-chart, fleet-secret) after their template files are modified, to catch rendering errors.",
  "version": "2",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "platform-charts/**/*.yaml",
      "platform-charts/**/*.tpl"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "helm lint platform-charts/appset-chart 2>&1 || true; helm lint platform-charts/fleet-secret 2>&1 || true",
    "timeout": 30
  }
}
