{
  "name": "peeks",
  "description": "Workshop IDE agent — EKS platform management, GitOps, Terraform, and troubleshooting",
  "prompt": "You are an AWS EKS expert helping a user manage their platform engineering environment on EKS. You are running on the workshop IDE instance.\n\nKey rules:\n- EKS Auto Mode is enabled — Karpenter is NOT running in clusters\n- EKS Capabilities manage ArgoCD, Kro, and ACK — these controllers are NOT running as pods\n- Always use deploy.sh/destroy.sh scripts, never raw terraform apply/destroy\n- Prefer GitOps workflow (modify Git, let ArgoCD sync) over manual kubectl apply\n- Check env vars with targeted echo commands, never dump full environment\n- For ArgoCD CLI auth errors, run argocd-refresh-token then source ~/.bashrc.d/platform.sh",
  "mcpServers": {
    "eks-mcp-server": {
      "disabled": false,
      "type": "stdio",
      "command": "/home/ec2-user/.local/share/mise/shims/uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://eks-mcp.us-west-2.api.aws/mcp",
        "--service",
        "eks-mcp",
        "--region",
        "us-west-2",
        "--log-level",
        "ERROR"
      ]
    },
    "aws-knowledge-mcp-server": {
      "url": "https://knowledge-mcp.global.api.aws",
      "type": "http"
    },
    "awslabs.aws-iac-mcp-server": {
      "command": "/home/ec2-user/.local/share/mise/shims/uvx",
      "args": ["awslabs.aws-iac-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": []
    }
  },
  "tools": [
    "@aws-knowledge-mcp-server",
    "@awslabs.aws-iac-mcp-server",
    "@eks-mcp-server",
    "introspect",
    "read",
    "shell",
    "use_aws",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "introspect",
    "@aws-knowledge-mcp-server"
  ],
  "toolsSettings": {
    "execute_bash": {
      "autoAllowReadonly": true
    },
    "use_aws": {
      "autoAllowReadonly": true
    },
    "@eks-mcp-server": {
      "autoAllowReadonly": true
    },
    "@awslabs.aws-iac-mcp-server": {
      "autoAllowReadonly": true
    }
  },
  "resources": [
    {
      "type": "knowledgeBase",
      "source": "file://.kiro/steering",
      "name": "Workshop Steering Guides",
      "indexType": "fast",
      "include": ["**/*.md"]
    },
    {
      "type": "knowledgeBase",
      "source": "file://.kiro/skills",
      "name": "Workshop Skills",
      "indexType": "fast",
      "include": ["**/SKILL.md"]
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "aws-knowledge-mcp-server/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:2854681af1bf3efd151181b445f3a0e670fdded6c9ce6210ba9271fbfb03a194",
    "source": "sha256:9f7f70a887ab2881288623b158d0335c3b87978cd265315bf49d194a5c57d403"
  }
}
