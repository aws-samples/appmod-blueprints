{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IamRolesPoliciesInstanceProfilesOidc",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": [
        "arn:*:iam::*:role/*",
        "arn:*:iam::*:policy/*",
        "arn:*:iam::*:instance-profile/*",
        "arn:*:iam::*:oidc-provider/*"
      ]
    },
    {
      "Sid": "IamRead",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "DenyAttachAwsManagedPolicyOutsideAllowlist",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:AttachUserPolicy",
        "iam:AttachGroupPolicy"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": "arn:*:iam::aws:policy/*"
        },
        "ArnNotLike": {
          "iam:PolicyARN": [
            "arn:*:iam::aws:policy/AWSGrafanaAccountAdministrator",
            "arn:*:iam::aws:policy/AWSSecurityHubFullAccess",
            "arn:*:iam::aws:policy/AWSXrayReadOnlyAccess",
            "arn:*:iam::aws:policy/AmazonDynamoDBFullAccess",
            "arn:*:iam::aws:policy/AmazonDynamoDBFullAccess_v2",
            "arn:*:iam::aws:policy/AmazonEC2ContainerRegistryPullOnly",
            "arn:*:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly",
            "arn:*:iam::aws:policy/AmazonEC2FullAccess",
            "arn:*:iam::aws:policy/AmazonEKSBlockStoragePolicy",
            "arn:*:iam::aws:policy/AmazonEKSClusterPolicy",
            "arn:*:iam::aws:policy/AmazonEKSComputePolicy",
            "arn:*:iam::aws:policy/AmazonEKSLoadBalancingPolicy",
            "arn:*:iam::aws:policy/AmazonEKSNetworkingPolicy",
            "arn:*:iam::aws:policy/AmazonEKSWorkerNodeMinimalPolicy",
            "arn:*:iam::aws:policy/AmazonEKSWorkerNodePolicy",
            "arn:*:iam::aws:policy/AmazonEKS_CNI_Policy",
            "arn:*:iam::aws:policy/AmazonPrometheusFullAccess",
            "arn:*:iam::aws:policy/AmazonPrometheusQueryAccess",
            "arn:*:iam::aws:policy/AmazonPrometheusRemoteWriteAccess",
            "arn:*:iam::aws:policy/AmazonRDSFullAccess",
            "arn:*:iam::aws:policy/AmazonS3FullAccess",
            "arn:*:iam::aws:policy/AmazonSSMManagedInstanceCore",
            "arn:*:iam::aws:policy/CloudWatchAgentServerPolicy",
            "arn:*:iam::aws:policy/SecretsManagerReadWrite",
            "arn:*:iam::aws:policy/service-role/AmazonGrafanaCloudWatchAccess"
          ]
        }
      }
    }
  ]
}
